# Supabase — taproot-dev
# Get these from `supabase projects api-keys --project-ref <ref>` or the dashboard.
# DB password is set at project creation and cannot be re-fetched (only reset).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PROJECT_REF=<project-ref>
SUPABASE_ANON_KEY=<jwt>
SUPABASE_SERVICE_ROLE_KEY=<jwt>
SUPABASE_DB_PASSWORD=<hex>

# Envelope encryption KEK — hex-encoded 32-byte AES-256 key. Stored as a
# Railway env var in production (see decisions/2026-04-27-taproot-security-model,
# 2026-05-16 amendment). Relocating it behind a separate boundary is
# post-launch hardening.
TAPROOT_KEK=

# Server
BASE_URL=
PORT=3777

# Stripe billing. STRIPE_DISABLED=1 makes checkout + portal return 503.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_ANNUAL_PRICE_ID=
STRIPE_PORTAL_RETURN_URL=
STRIPE_DISABLED=

# OAuth — HMAC secret binding GET /authorize to its POST (M1).
# Optional: falls back to TAPROOT_KEK if unset.
OAUTH_CSRF_SECRET=

# Observability
SENTRY_DSN=
DISCORD_ERROR_WEBHOOK_URL=
DISCORD_FEEDBACK_WEBHOOK_URL=
